# Database
DATABASE_URL="postgresql://folio:folio@localhost:5432/folio_dev"

# API
NODE_ENV="development"
API_PORT=3001
API_HOST="0.0.0.0"

# Auth
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS — Vite dev server
CORS_ORIGIN="http://localhost:5173"

# Cloudinary — added in Phase 3
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (email) — added in Phase 6
RESEND_API_KEY=""
EMAIL_FROM="Folio <noreply@yourdomain.com>"

# Stripe — added in Phase 6
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# OpenAI — added in Phase 7
OPENAI_API_KEY=""

# Datadog — added in Phase 9
DD_API_KEY=""
DD_APP_KEY=""
DD_SERVICE="folio-api"
DD_ENV="development"

# Database
DATABASE_URL="postgresql://folio:folio@localhost:5432/folio_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# API
NODE_ENV="development"
API_PORT=3001
API_HOST="0.0.0.0"

# Auth
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS — Vite dev server
CORS_ORIGIN="http://localhost:5173"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (email)
RESEND_API_KEY=""
EMAIL_FROM="Folio <noreply@yourdomain.com>"

# OpenAI
OPENAI_API_KEY=""

# Datadog (Phase 9)
DD_API_KEY=""
DD_APP_KEY=""
DD_SERVICE="folio-api"
DD_ENV="development"

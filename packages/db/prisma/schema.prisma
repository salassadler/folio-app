generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  bio          String?
  avatarUrl    String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  works         Work[]
  annotations   Annotation[]
  threads       AnnotationThread[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Workshop (Multi-tenancy root) ───────────────────────────────────────────

model Workshop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  rules       String?
  isPublic    Boolean  @default(false)
  noCopyPaste Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships    Membership[]
  works          Work[]
  critiqueRounds CritiqueRound[]
  invites        Invite[]

  @@map("workshops")
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  workshopId String
  role       MembershipRole
  joinedAt   DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([userId, workshopId])
  @@map("memberships")
}

enum MembershipRole {
  OWNER
  MODERATOR
  MEMBER
}

model Invite {
  id         String         @id @default(cuid())
  workshopId String
  email      String
  token      String         @unique
  role       MembershipRole @default(MEMBER)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invites")
}

// ─── Works ───────────────────────────────────────────────────────────────────

model Work {
  id          String    @id @default(cuid())
  title       String
  genre       String?
  tags        String[]
  state       WorkState @default(DRAFT)
  authorId    String
  workshopId  String?
  coverImageUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  workshop       Workshop?       @relation(fields: [workshopId], references: [id])
  versions       WorkVersion[]
  critiqueRounds CritiqueRound[]
  publication    Publication?

  @@index([authorId, state])
  @@index([workshopId, state])
  // GIN index for tags array and full-text search — added via migration SQL
  @@map("works")
}

enum WorkState {
  DRAFT
  SUBMITTED
  CRITIQUE_OPEN
  IN_SESSION
  REVEAL
  REVISED
  PUBLISHED
  WITHDRAWN
  REJECTED
}

model WorkVersion {
  id         String   @id @default(cuid())
  workId     String
  content    Json     // Lexical editor JSON state
  versionNum Int
  createdAt  DateTime @default(now())

  work        Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  annotations Annotation[]

  @@unique([workId, versionNum])
  @@index([workId])
  @@map("work_versions")
}

// ─── Critique ─────────────────────────────────────────────────────────────────

model CritiqueRound {
  id         String             @id @default(cuid())
  workId     String
  workshopId String
  openAt     DateTime
  closeAt    DateTime
  revealAt   DateTime
  isAnonymous Boolean           @default(true)
  state      CritiqueRoundState @default(SCHEDULED)
  createdAt  DateTime           @default(now())

  work        Work        @relation(fields: [workId], references: [id], onDelete: Cascade)
  workshop    Workshop    @relation(fields: [workshopId], references: [id])
  annotations Annotation[]

  @@index([workId])
  @@map("critique_rounds")
}

enum CritiqueRoundState {
  SCHEDULED
  OPEN
  IN_SESSION
  CLOSED
  REVEALED
}

model Annotation {
  id              String   @id @default(cuid())
  workVersionId   String
  critiqueRoundId String?
  authorId        String
  pseudonym       String?  // set during anonymous rounds, revealed after revealAt
  startOffset     Int
  endOffset       Int
  quote           String   // the selected text, stored for resilience against content changes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workVersion   WorkVersion             @relation(fields: [workVersionId], references: [id], onDelete: Cascade)
  critiqueRound CritiqueRound?          @relation(fields: [critiqueRoundId], references: [id])
  author        User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  threads       AnnotationThread[]
  endorsements  AnnotationEndorsement[]

  @@index([workVersionId])
  @@index([critiqueRoundId])
  @@map("annotations")
}

model AnnotationThread {
  id           String   @id @default(cuid())
  annotationId String
  authorId     String
  content      String
  pseudonym    String?
  createdAt    DateTime @default(now())

  annotation Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([annotationId])
  @@map("annotation_threads")
}

model AnnotationEndorsement {
  id           String   @id @default(cuid())
  annotationId String
  userId       String
  createdAt    DateTime @default(now())

  annotation Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

  @@unique([annotationId, userId])
  @@map("annotation_endorsements")
}

// ─── Publishing ───────────────────────────────────────────────────────────────

model Publication {
  id          String   @id @default(cuid())
  workId      String   @unique
  authorId    String
  publishedAt DateTime @default(now())

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([authorId, publishedAt])
  @@map("publications")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

enum NotificationType {
  CRITIQUE_ROUND_OPENED
  CRITIQUE_ROUND_CLOSED
  ANNOTATION_CREATED
  ANNOTATION_REPLY
  WORK_PUBLISHED
}
